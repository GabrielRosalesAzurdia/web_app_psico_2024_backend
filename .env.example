# Copiar a `.env` para desarrollo local. Nunca commitear el .env real.
# En produccion (Render) estas variables las inyecta la plataforma
# directamente; este archivo y python-dotenv son inertes ahi.

DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Postgres (recomendado, coincide con el motor de produccion):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tulip_dev
# O sqlite para un setup local sin configuracion adicional:
# DATABASE_URL=sqlite:///db.sqlite3
